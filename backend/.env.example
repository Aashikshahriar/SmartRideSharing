PROJECT_NAME=SmartRideAI
VERSION=1.0
DATABASE_URL=sqlite:///./smartride.db
SECRET_KEY=ChangeThisLater
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: enables the free-text chatbot. Leave blank to disable it
# gracefully (ETA/fraud/driver quick-answers keep working either way).
# See README > AI Chatbot for free API key sources.
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.groq.com/openai/v1
CHATBOT_MODEL=openai/gpt-oss-20b
